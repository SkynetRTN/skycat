# Local Docker Compose settings for the standalone Skycat repo.

LOCAL_IMAGE_TAG=latest

SKYCAT_DB_BACKEND=postgresql+psycopg
SKYCAT_DB_HOST=skycat-postgres
SKYCAT_DB_PORT=5432
SKYCAT_DB_NAME=catalogs
SKYCAT_DB_USER=catalog_reader
SKYCAT_DB_SSLMODE=

SKYCAT_DB_BOOTSTRAP_USER=catalog_admin
SKYCAT_DB_ADMIN_USER=catalog_owner
SKYCAT_DB_INGEST_USER=catalog_ingest
SKYCAT_DB_READER_USER=catalog_reader

SKYCAT_DATA_ROOT=/catalog-data
SKYCAT_WORK_ROOT=/catalog-work

# Host path mounted read-only into /catalog-data by infra/docker/compose.yaml.
SKYCAT_HOST_DATA_ROOT=/srv/agents/catalogs/photometry
